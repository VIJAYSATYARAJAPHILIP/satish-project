# Copy this file to .env and choose a strong, unique password.
OWNER_PASSWORD=replace-with-a-long-unique-password
# Keep this random and private. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
# Optional persistent folder on a hosting provider
DATA_DIR=./data
UPLOADS_DIR=./uploads
